rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) { return request.auth != null && request.auth.uid == userId; }
    function validTask() {
      return request.resource.data.keys().hasOnly(['title', 'nextStep', 'category', 'done', 'createdAt', 'startDate', 'dueDate'])
        && request.resource.data.keys().hasAll(['title', 'nextStep', 'category', 'done', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.nextStep is string && request.resource.data.nextStep.size() <= 180
        && request.resource.data.category in ['Urgente', 'Importante', 'Circunstancial']
        && request.resource.data.done is bool && request.resource.data.createdAt is number
        && request.resource.data.get('startDate', '') is string
        && request.resource.data.get('dueDate', '') is string
        && request.resource.data.get('startDate', '').size() <= 10
        && request.resource.data.get('dueDate', '').size() <= 10
        && (request.resource.data.get('dueDate', '') == '' || request.resource.data.get('startDate', '') <= request.resource.data.get('dueDate', ''));
    }
    function validDiagnosis() {
      return request.resource.data.keys().hasOnly(['answers', 'createdAt'])
        && request.resource.data.keys().hasAll(['answers', 'createdAt'])
        && request.resource.data.answers is list && request.resource.data.answers.size() == 9
        && request.resource.data.createdAt is number;
    }
    match /users/{userId}/tasks/{taskId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validTask();
    }
    match /users/{userId}/diagnoses/{diagnosisId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validDiagnosis();
    }
    function validProfile() {
      return request.resource.data.keys().hasOnly(['displayName', 'focusMinutes', 'notifyEnabled', 'notifyTime', 'timezone', 'lastNotifiedDate'])
        && request.resource.data.keys().hasAll(['displayName', 'focusMinutes', 'notifyEnabled', 'notifyTime', 'timezone'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 80
        && request.resource.data.focusMinutes is int && request.resource.data.focusMinutes >= 5 && request.resource.data.focusMinutes <= 120
        && request.resource.data.notifyEnabled is bool
        && request.resource.data.notifyTime is string && request.resource.data.notifyTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.timezone is string && request.resource.data.timezone.size() <= 80;
    }
    match /profiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validProfile() && !('lastNotifiedDate' in request.resource.data);
      allow update: if isOwner(userId) && validProfile()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'focusMinutes', 'notifyEnabled', 'notifyTime', 'timezone']);
      match /tokens/{installationId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
          && request.resource.data.keys().hasAll(['token', 'updatedAt'])
          && request.resource.data.token is string && request.resource.data.token.size() > 20 && request.resource.data.token.size() < 500
          && request.resource.data.updatedAt is number;
      }
    }
  }
}
